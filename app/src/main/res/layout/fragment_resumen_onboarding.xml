<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondomain"
    android:padding="24dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:layout_marginBottom="32dp"
        android:padding="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/gray"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:weightSum="1">

                <TextView
                    android:text="Revisa tus resultados"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_weight="0.6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white" />

            </LinearLayout>

            <!-- Actividad física -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tu actividad física"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000000"/>

            <TextView
                android:id="@+id/tvActividadFisica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="..."
                android:textSize="16sp"
                android:textColor="#444444"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="6dp" />

            <!-- Objetivo -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tu objetivo"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000000"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/tvObjetivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="..."
                android:textSize="16sp"
                android:textColor="#444444"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="6dp" />

            <!-- Restricciones alimentarias -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tus restricciones alimentarias"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000000"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/tvRestricciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="..."
                android:textSize="16sp"
                android:textColor="#444444"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="6dp" />

            <!-- Organización diaria -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tu organización diaria de comidas"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#000000"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/tvOrganizacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="..."
                android:textSize="16sp"
                android:textColor="#444444"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="6dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnGenerarPlan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Generar Plan Personalizado"
        android:backgroundTint="@color/verde"
        android:textColor="@android:color/white"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/btnRealizarTests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver a realizar los tests"
        android:backgroundTint="@color/gray"
        android:textColor="@android:color/white"
        android:textStyle="bold"/>
</LinearLayout>
