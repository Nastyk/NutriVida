<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/fondomain">

    <!-- Barra de botones -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <!-- Botón Atrás -->
        <ImageButton
            android:id="@+id/btnAtras"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_chevron_left_custom"
            android:scaleType="fitCenter"
            app:tint="@color/verde" />
    </RelativeLayout>

    <!-- CardView contenedor de datos -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Contenedor para los datos del usuario -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="10dp"
                android:layout_gravity="center">

                <TextView
                    android:text="Nombre:"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNombre"
                    android:layout_width="219dp"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:inputType="textPersonName" />

                <TextView
                    android:text="Apellido 1:"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etApellido1"
                    android:layout_width="218dp"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:inputType="textPersonName" />

                <TextView
                    android:text="Apellido 2:"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etApellido2"
                    android:layout_width="219dp"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:inputType="textPersonName" />

                <TextView
                    android:text="Peso (kg):"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etPeso"
                    android:layout_width="219dp"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:inputType="numberDecimal" />

                <TextView
                    android:text="Altura (cm):"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAltura"
                    android:layout_width="219dp"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:inputType="numberDecimal" />

                <TextView
                    android:text="IMC:"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvIMCPerfil"
                    android:layout_width="218dp"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="18sp" />

                <TextView
                    android:text="Edad:"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etEdad"
                    android:layout_width="221dp"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:inputType="number" />
            </GridLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
