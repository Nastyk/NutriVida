<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center"
    android:background="@drawable/fondoparamain">

    <RelativeLayout
        android:layout_width="349dp"
        android:layout_height="64dp"
        android:padding="5dp">

        <!-- Botón "Ir a Inicio" (Izquierda) -->

        <!-- Botón "Editar" (Derecha) -->
        <ImageButton
            android:id="@+id/btnEditarPerfil"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Editar Perfil"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_editar"
            app:tint="@color/verde" />

        <ImageButton
            android:id="@+id/btnIrAmain"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Ir a Inicio"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_irinicio"
            app:tint="@color/verde" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="389dp"
        android:layout_height="624dp"
        android:layout_marginTop="-30dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- EditText para modificar el nombre -->
        <TextView
            android:id="@+id/tvTituloPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:fontFamily="casual"
            android:text="Perfil de usuario"
            android:textColor="@color/azul"
            android:textSize="30sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNombrePerfil"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:enabled="false"
            android:focusable="false"
            android:hint="Nombre"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etPesoPerfil"
            android:layout_width="301dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:enabled="false"
            android:focusable="false"
            android:hint="Peso (kg)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etAlturaPerfil"
            android:layout_width="302dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:enabled="false"
            android:focusable="false"
            android:hint="Altura (m)"
            android:inputType="numberDecimal" />

        <!-- TextView para mostrar el IMC actual -->
        <TextView
            android:id="@+id/tvIMCPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="IMC: --"
            android:textSize="18sp" />

        <!-- TextView para mostrar la racha de días completados -->
        <TextView
            android:id="@+id/tvRacha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Días cumplidos este mes: 0"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Botón Guardar Cambios -->
        <Button
            android:id="@+id/btnGuardarPerfil"
            android:layout_width="261dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/verde"
            android:text="Guardar Cambios"
            android:textColor="@android:color/white" />
    </LinearLayout>

</LinearLayout>
