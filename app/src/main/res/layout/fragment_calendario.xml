<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center"
    android:background="@drawable/fondomain">

    <ImageView
        android:id="@+id/logoNutriVida"
        android:layout_width="193dp"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="Logo NutriVida"
        android:src="@drawable/logoText1" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Header personalizado -->
            <LinearLayout
                android:id="@+id/calendarHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|center"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:id="@+id/btnPrevMonth"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chevron_left_custom"
                    android:contentDescription="Mes anterior"
                    app:tint="@color/black" />

                <TextView
                    android:id="@+id/txtMonthTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Junio 2025"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center" />

                <ImageView
                    android:id="@+id/btnNextMonth"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chevron_right_custom"
                    android:contentDescription="Mes siguiente"
                    app:tint="@color/black" />
            </LinearLayout>

            <!-- Calendario sin encabezado nativo -->
            <com.prolificinteractive.materialcalendarview.MaterialCalendarView
                android:id="@+id/calendarView"
                android:layout_width="match_parent"
                android:layout_height="420dp"
                android:background="@drawable/calendar_background"
                app:mcv_showOtherDates="all"
                app:mcv_arrowColor="@android:color/transparent"
                app:mcv_headerTextAppearance="@null" />
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnIrComida"
        android:layout_width="189dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/verde"
        android:text="Registrar Comidas"
        android:textColor="@android:color/white" />

</LinearLayout>
