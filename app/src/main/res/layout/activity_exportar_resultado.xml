<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Flecha de atrás en la esquina superior izquierda con margen -->
    <ImageButton
        android:id="@+id/btnIrAtras"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_atras"
        android:contentDescription="Ir Atrás"
        android:scaleType="fitCenter"
        app:tint="@color/verde" />

    <!-- Contenedor centrado -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:layout_margin="24dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloExportar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Exportar Resultado en PDF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <!-- Botón con color personalizado -->
        <Button
            android:id="@+id/btnGenerarPDF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generar PDF"
            android:padding="16dp"
            android:backgroundTint="@color/verde"
            android:textColor="@android:color/white" />
    </LinearLayout>
</RelativeLayout>
