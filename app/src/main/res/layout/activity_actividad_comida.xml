<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center"
    android:background="@drawable/fondomain">

    <!-- Contenedor superior solo para la flecha de atrás -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Botón de ir atrás con icono -->
        <ImageButton
            android:id="@+id/btnCalendar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_calendar"
            android:contentDescription="Ir Calendario"
            android:scaleType="fitCenter"
            app:tint="@color/verde" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <!-- Botón de ir atrás -->
        <ImageButton
            android:id="@+id/btnIrAtras"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_atras"
            android:contentDescription="Día anterior"
            android:scaleType="fitCenter"
            android:layout_gravity="center_vertical"
            app:tint="@color/verde" />

        <!-- Texto con la fecha -->
        <TextView
            android:id="@+id/tvFechaComida"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Hoy"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_gravity="center_vertical" />

        <!-- Botón de ir adelante -->
        <ImageButton
            android:id="@+id/btnIrAdelante"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_adelante"
            android:contentDescription="Día siguiente"
            android:scaleType="fitCenter"
            android:layout_gravity="center_vertical"
            app:tint="@color/verde" />
    </LinearLayout>

    <!--desayuno-->
    <TextView
        android:id="@+id/tvDesayuno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desayuno: "
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDesayunoSeleccionado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Ninguno"
            android:textSize="18sp"
            android:textColor="@android:color/black"/>

        <ImageButton
            android:id="@+id/btnBorrarDesayuno"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Borrar desayuno"
            android:src="@drawable/ic_borrar"
            app:tint="@color/red" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCaloriasDesayuno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calorías: 0"
        android:textSize="16sp"
        android:layout_marginBottom="5dp"/>

    <Button
        android:id="@+id/btnAnadirDesayuno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Añadir Desayuno"
        android:backgroundTint="@color/verde"
        android:textColor="@android:color/white" />

    <CheckBox
        android:id="@+id/cbDesayuno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Marcar como hecho"/>

    <!-- Comida -->
    <TextView
        android:id="@+id/tvComida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comida: "
        android:textSize="18sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvComidaSeleccionada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Ninguna"
            android:textSize="18sp"
            android:textColor="@android:color/black"/>

        <ImageButton
            android:id="@+id/btnBorrarComida"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Borrar comida"
            android:src="@drawable/ic_borrar"
            app:tint="@color/red" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCaloriasComida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calorías: 0"
        android:textSize="16sp"
        android:layout_marginBottom="5dp"/>

    <Button
        android:id="@+id/btnAnadirComida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Añadir Comida"
        android:backgroundTint="@color/verde"
        android:textColor="@android:color/white" />

    <CheckBox
        android:id="@+id/cbComida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Marcar como hecho"/>

    <!-- Cena -->
    <TextView
        android:id="@+id/tvCena"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cena: "
        android:textSize="18sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvCenaSeleccionada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Ninguna"
            android:textSize="18sp"
            android:textColor="@android:color/black"/>

        <ImageButton
            android:id="@+id/btnBorrarCena"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Borrar cena"
            android:src="@drawable/ic_borrar"
            app:tint="@color/red" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCaloriasCena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calorías: 0"
        android:textSize="16sp"
        android:layout_marginBottom="5dp"/>

    <Button
        android:id="@+id/btnAnadirCena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Añadir Cena"
        android:backgroundTint="@color/verde"
        android:textColor="@android:color/white" />

    <CheckBox
        android:id="@+id/cbCena"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Marcar como hecho"/>

    <!-- Total de kcal -->
    <TextView
        android:id="@+id/tvTotalKcal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total kcal: 0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="15dp"/>

    <!-- Botón Guardar -->
    <Button
        android:id="@+id/btnGuardarComida"
        android:layout_width="266dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/verde"
        android:text="Guardar Comidas"
        android:textColor="@android:color/white" />
</LinearLayout>
