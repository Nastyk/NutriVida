<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center"
    android:background="@drawable/fondoparamain">

    <!-- Fecha -->
    <TextView
        android:id="@+id/tvFechaComida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:text="Comidas del día: --"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnIrAtras"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Atrás"
        android:backgroundTint="@color/orange"/>

    <!-- Desayuno -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/tvDesayuno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desayuno: "
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDesayunoSeleccionado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ninguno"
            android:textSize="18sp"
            android:textColor="@android:color/black"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvCaloriasDesayuno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calorías: 0"
        android:textSize="16sp"
        android:layout_marginBottom="5dp"/>

    <Button
        android:id="@+id/btnAnadirDesayuno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Añadir Desayuno"
        android:backgroundTint="@color/orange"
        android:textColor="@android:color/white" />

    <CheckBox
        android:id="@+id/cbDesayuno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Marcar como hecho"/>

    <!-- Comida -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/tvComida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comida: "
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvComidaSeleccionada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ninguna"
            android:textSize="18sp"
            android:textColor="@android:color/black"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvCaloriasComida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calorías: 0"
        android:textSize="16sp"
        android:layout_marginBottom="5dp"/>

    <Button
        android:id="@+id/btnAnadirComida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Añadir Comida"
        android:backgroundTint="@color/orange"
        android:textColor="@android:color/white" />

    <CheckBox
        android:id="@+id/cbComida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Marcar como hecho"/>

    <!-- Cena -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/tvCena"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cena: "
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCenaSeleccionada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ninguna"
            android:textSize="18sp"
            android:textColor="@android:color/black"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvCaloriasCena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calorías: 0"
        android:textSize="16sp"
        android:layout_marginBottom="5dp"/>

    <Button
        android:id="@+id/btnAnadirCena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Añadir Cena"
        android:backgroundTint="@color/orange"
        android:textColor="@android:color/white" />

    <CheckBox
        android:id="@+id/cbCena"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Marcar como hecho"/>

    <!-- Total de kcal -->
    <TextView
        android:id="@+id/tvTotalKcal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total kcal: 0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="15dp"/>

    <!-- Botón Guardar -->
    <Button
        android:id="@+id/btnGuardarComida"
        android:layout_width="266dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/orange"
        android:contentDescription="Botón para guardar las comidas del día"
        android:importantForAccessibility="yes"
        android:text="Guardar Comidas"
        android:textColor="@android:color/white" />
</LinearLayout>
