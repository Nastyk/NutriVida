<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="24dp" android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Título de la pantalla -->
        <TextView
            android:id="@+id/tvTituloResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resultados del Test"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Resultado emocional -->
        <TextView
            android:id="@+id/tvResultadoEmocional"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Riesgo Emocional: ..."
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <!-- Resultado físico -->
        <TextView
            android:id="@+id/tvResultadoFisico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Riesgo Físico: ..."
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <!-- Resultado profesional -->
        <TextView
            android:id="@+id/tvResultadoProfesional"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Riesgo Profesional: ..."
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <!-- Advertencia o mensaje extra -->
        <TextView
            android:id="@+id/tvAdvertencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Advertencia: ..."
            android:textSize="16sp"
            android:textColor="#FF0000"
            android:layout_marginBottom="16dp" />

        <!-- Rango calórico recomendado -->
        <TextView
            android:id="@+id/tvRangoCalorico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rango calórico recomendado: ..."
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <!-- Botón para reiniciar el test -->
        <Button
            android:id="@+id/btnReiniciar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reiniciar test" />
    </LinearLayout>
</ScrollView>