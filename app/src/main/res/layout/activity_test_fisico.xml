<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center">

    <!-- Contenedor superior solo para la flecha de atrás -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Botón de ir atrás con icono -->
        <ImageButton
            android:id="@+id/btnIrAtras"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_atras"
            android:contentDescription="Ir Atrás"
            android:scaleType="fitCenter"
            app:tint="@color/verde" />
    </RelativeLayout>

    <!-- Contenido con scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp"
        android:background="#F5FFF8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvProgreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paso 2 de 3"
                android:textColor="#555"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>
            <!-- Título de la pantalla -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Evaluación Física"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp" />

            <!-- Pregunta 1 -->
            <TextView
                android:text="¿Cuántos días a la semana haces ejercicio físico?"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <RadioGroup
                android:id="@+id/rgEjercicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/rbEj0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 días" />
                <RadioButton
                    android:id="@+id/rbEj1_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1-2 días" />
                <RadioButton
                    android:id="@+id/rbEj3_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3-5 días" />
                <RadioButton
                    android:id="@+id/rbEj6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6 o más días" />
            </RadioGroup>

            <!-- Pregunta 2 -->
            <TextView
                android:text="¿Cuántas horas al día pasas sentado/a?"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />
            <RadioGroup
                android:id="@+id/rgSedentarismo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RadioButton android:id="@+id/rbSed0_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0-4h" />
                <RadioButton android:id="@+id/rbSed5_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5-8h" />
                <RadioButton android:id="@+id/rbSed9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9h o más" />
            </RadioGroup>

            <!-- Pregunta 3 -->
            <TextView
                android:text="¿Tienes alguna limitación física actual?"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />
            <RadioGroup
                android:id="@+id/rgLimitacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/rbLimNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No" />
                <RadioButton
                    android:id="@+id/rbLimLeve"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Leve" />
                <RadioButton
                    android:id="@+id/rbLimImportante"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Importante" />
            </RadioGroup>

            <!-- Botón para continuar -->
            <Button
                android:id="@+id/btnEvaluarFisico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/verde"
                android:text="Siguiente"
                android:layout_marginTop="32dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>