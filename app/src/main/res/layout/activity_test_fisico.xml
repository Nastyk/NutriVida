<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="24dp" android:background="#F0FFF5">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título de la pantalla -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Evaluación Física"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <!-- Pregunta 1 -->
        <TextView
            android:text="¿Cuántos días a la semana haces ejercicio físico?"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
        <RadioGroup
            android:id="@+id/rgEjercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/rbEj0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 días" />
            <RadioButton
                android:id="@+id/rbEj1_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1-2 días" />
            <RadioButton
                android:id="@+id/rbEj3_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3-5 días" />
            <RadioButton
                android:id="@+id/rbEj6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6 o más días" />
        </RadioGroup>

        <!-- Pregunta 2 -->
        <TextView
            android:text="¿Cuántas horas al día pasas sentado/a?"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
        <RadioGroup
            android:id="@+id/rgSedentarismo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rbSed0_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0-4h" />
            <RadioButton android:id="@+id/rbSed5_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5-8h" />
            <RadioButton android:id="@+id/rbSed9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9h o más" />
        </RadioGroup>

        <!-- Pregunta 3 -->
        <TextView
            android:text="¿Tienes alguna limitación física actual?"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
        <RadioGroup
            android:id="@+id/rgLimitacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RadioButton
                android:id="@+id/rbLimNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No" />
            <RadioButton
                android:id="@+id/rbLimLeve"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Leve" />
            <RadioButton
                android:id="@+id/rbLimImportante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Importante" />
        </RadioGroup>

        <!-- Botón para continuar -->
        <Button
            android:id="@+id/btnEvaluarFisico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Siguiente"
            android:layout_marginTop="32dp" />
    </LinearLayout>
</ScrollView>