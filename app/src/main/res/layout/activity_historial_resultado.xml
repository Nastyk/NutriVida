<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="24dp" android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloHistorial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Historial de Resultado Reciente"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Resultado emocional -->
        <TextView
            android:id="@+id/tvHistorialEmocional"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Riesgo emocional guardado:"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Resultado físico -->
        <TextView
            android:id="@+id/tvHistorialFisico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Riesgo físico guardado:"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Resultado profesional -->
        <TextView
            android:id="@+id/tvHistorialProfesional"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Riesgo profesional guardado:"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Rango calórico -->
        <TextView
            android:id="@+id/tvHistorialRango"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rango calórico guardado:"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>